# Copy this file to .env and fill in your keys. Never commit .env or share it.

# Order in which providers are tried (comma separated): groq, gemini, ollama
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Groq (one key is enough; GROQ_API_KEY1..9 also work)
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Gemini: quotas are per Google Cloud PROJECT, so make each key in a SEPARATE project
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_THINKING_BUDGET=0

# Ollama (local backup, no quota)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Tuning
LLM_TIMEOUT=30
LLM_OLLAMA_TIMEOUT=120
LLM_CACHE=1
# LLM_CACHE_PATH=.llm_cache.sqlite
